# Nivesh starts in safe mock mode. Never expose these values to the browser.
BROKER_MODE=mock
KITE_API_KEY=
KITE_API_SECRET=
DATABASE_URL=

# Server-side kill switch. Keep false until the approval execution service is complete.
NIVESH_LIVE_TRADING_ENABLED=false

# Future data providers
NEWS_API_KEY=
AI_PROVIDER_API_KEY=
